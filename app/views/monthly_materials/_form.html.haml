-# locals: (orgs: nil, organisation: nil, month:)

= form_with url: monthly_materials_path,
            method: :get,
            html: { class: 'w-full flex flex-wrap justify-center gap-3' } do |f|
  - if orgs.present?
    .flex-row.items-center
      = label_tag :org, t('.organisation')
      = select_tag :org,
                   options_for_select(orgs.pluck(:name, :id), organisation&.id || params[:org]),
                   onchange: 'this.form.requestSubmit()'

  .flex-row.items-center
    = label_tag :month, t('.month')
    = month_field_tag :month,
                      month.strftime('%Y-%m'),
                      required: true,
                      class: 'cursor-pointer',
                      data: { controller: 'month-picker',
                              action: 'click->month-picker#open' }

  = button_tag t('.search'), type: :submit, class: 'btn btn-main', name: nil
