= render 'shared/subtitle', text: 'Tests'

%main.flex.flex-col.gap-6.p-3
  = render 'tests/tabs', active: :analytics

  = form_with url: analytics_tests_path, method: :get, class: 'grid grid-cols-1 md:grid-cols-3 gap-3 p-4 rounded border border-main bg-white' do |form|
    .flex.flex-col.gap-1
      = form.label :organisation_id, 'Organisation', class: 'font-bold'
      = form.collection_select :organisation_id, @organisations, :id, :name, { selected: @organisation.id }, class: 'input'
    .flex.flex-col.gap-1
      = form.label :test_id, 'Test', class: 'font-bold'
      - test_options = @tests.map { |test| ["#{test.name} (#{test.short_level})", test.id] }
      = form.select :test_id, test_options, { include_blank: 'All tests overview', selected: params[:test_id] }, class: 'input'
    .flex.items-end.justify-end
      = form.submit 'Update analytics', class: 'btn btn-main'

  - unless @selected_test
    .rounded.border-2.border-main.bg-white.p-4
      %h2 All schools overview
      %p.text-sm.mb-3 #{@overview.period || 'No results available'} · select a test above for detailed analytics
      - if @overview.any?
        %div{ class: 'max-h-[42rem] overflow-y-auto' }
          %div{ style: "height: #{@overview.chart_height}px" }
            %canvas{ data: { controller: 'chart',
                             'chart-data-value': @overview.chart_data.to_json,
                             'chart-options-value': { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { min: @overview.chart_min, max: 100 } }, plugins: { legend: { display: true } } }.to_json,
                             'chart-type-value': 'bar' } }
      - else
        .p-10.text-center No test results are available for this organisation.

    .grid.grid-cols-1.xl:grid-cols-2.gap-6
      - @overview_reports.each do |label, overview|
        .rounded.border.border-main.bg-white.p-4
          %h2= label
          %p.text-sm.mb-3 Overall school average comparison
          - if overview.any?
            %div{ class: 'max-h-[42rem] overflow-y-auto' }
              %div{ style: "height: #{overview.chart_height}px" }
                %canvas{ data: { controller: 'chart',
                                 'chart-data-value': overview.chart_data.to_json,
                                 'chart-options-value': { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { min: overview.chart_min, max: 100 } }, plugins: { legend: { display: true } } }.to_json,
                                 'chart-type-value': 'bar' } }
          - else
            .h-72.flex.items-center.justify-center.text-center No results in this period
  - else
    .flex.flex-wrap.justify-between.items-center.gap-2
      %div
        %h2 #{@selected_test.name} (#{@selected_test.short_level})
        %p.text-sm Main tables use: #{@reporting_period || 'No results available'}
      %p.text-sm School labels show how many results contributed to each average.

    - summary = @report.summary
    .grid.grid-cols-2.md:grid-cols-4.xl:grid-cols-8.gap-3
      - { 'Results' => summary[:results], 'Students' => summary[:students], 'Schools' => summary[:schools], 'Average score' => summary[:average] ? "#{summary[:average]}%" : '—', 'Moved up' => summary[:improved], 'Maintained' => summary[:maintained], 'Moved down' => summary[:declined], 'Override rate' => "#{summary[:override_rate]}%" }.each do |label, value|
        .rounded.border.border-main.bg-white.p-3.text-center
          .text-2xl.font-bold.text-secondary= value
          .text-sm= label

    - if summary[:results].zero?
      .rounded.border.border-main.bg-white.p-8.text-center
        %h2 No results match this test
        %p There are no recorded results in the last five years.
    - else
      .rounded.border-2.border-main.bg-white.p-4
        %h2 Current school comparison
        %p.text-sm.mb-3= @reporting_period
        %div{ class: 'max-h-[42rem] overflow-y-auto' }
          %div{ style: "height: #{@report.school_chart_height}px" }
            %canvas{ data: { controller: 'chart',
                             'chart-data-value': @report.school_comparison_chart.to_json,
                             'chart-options-value': { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { min: @report.school_chart_min, max: 100 } }, plugins: { legend: { display: true } } }.to_json,
                             'chart-type-value': 'bar' } }

      = render 'analytics_table', title: 'Schools comparison', table: 'schools', rows: @report.school_rows,
               columns: { name: 'School', organisation: 'Organisation', students: 'Students', results: 'Results', average: 'Average %', listening: 'Listening %', reading: 'Reading %', writing: 'Writing %', speaking: 'Speaking %', improved_rate: 'Moved up %', override_rate: 'Override %' }
      = render 'analytics_table', title: 'Student progress', table: 'students', rows: @report.student_rows,
               columns: { date: 'Date', student: 'Student', student_id: 'Student ID', school: 'School', test: 'Test', score: 'Score %', change: 'Change', previous_level: 'Previous level', new_level: 'New level' }
