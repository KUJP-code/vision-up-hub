.lm-guide-panel#lm-video-guide{ hidden: true,
                                data: { 'screen-mirroring-test-target': 'guidePanel' } }
  .lm-guide-heading
    %h2{ data: { 'screen-mirroring-test-target': 'videoTitle' } } みんなであいさつしよう！
    %label
      %span.lm-sr-only チャプターを選択
      %select{ data: { 'screen-mirroring-test-target': 'chapterPicker',
                       action: 'screen-mirroring-test#selectChapter' } }
  .lm-guide-columns
    %section
      %h3 レッスンのねらい
      %p{ data: { 'screen-mirroring-test-target': 'guideObjective' } }
      %h3 準備するもの
      %p{ data: { 'screen-mirroring-test-target': 'guideMaterials' } }
    %section
      %h3{ data: { 'screen-mirroring-test-target': 'chapterTitle' } }
      %p{ data: { 'screen-mirroring-test-target': 'guide' } }
    %section
      %h3 声かけのヒント
      %p{ data: { 'screen-mirroring-test-target': 'guideTip' } }
