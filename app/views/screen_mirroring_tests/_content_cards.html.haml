:ruby
  activity = kind == 'activity'
  story_description = '登場人物といっしょに、英語のお話を楽しみましょう。次に何が起こるかな？'

.lm-card-grid
  - items.each_with_index do |item, index|
    - title = activity ? item.fetch('title') : item
    - video_source = activity ? item.fetch('video') : video
    - content_key = activity ? item.fetch('key') : 'story'
    %article.lm-card.lm-content-card{ data: { category: activity ? item.fetch('category') : nil } }
      .lm-content-thumbnail{ class: "lm-thumbnail-#{kind}",
                             data: { 'screen-mirroring-test-target': 'thumbnail', video: video_source } }
        %img{ hidden: true, alt: '', width: 960, height: 540 }
        .lm-thumbnail-placeholder
          = render 'icon', name: activity ? 'activity' : 'book'
          %span= title
      - if activity
        %p.lm-eyebrow 第１週 · アクティビティ #{index + 1}
      %h2= title
      %p.lm-card-description= activity ? item.fetch('description') : story_description
      .lm-card-buttons
        %button.lm-pill.lm-primary{ type: 'button',
                                    data: { action: 'screen-mirroring-test#launchVideo',
                                            src: video_source,
                                            content_key:,
                                            kind:,
                                            title: } }
          = activity ? 'アクティビティをはじめる' : 'ストーリーをはじめる'
          = render 'icon', name: 'play'
        - if activity
          %button.lm-pill{ type: 'button',
                           data: { action: 'screen-mirroring-test#previewResource',
                                   title: "#{title} · 先生用ガイド", content_key:, resource_kind: 'guide' } }
            先生用ガイド
            = render 'icon', name: 'download'
          - unless item.fetch('category') == '教材不要'
            %button.lm-pill{ type: 'button',
                             data: { action: 'screen-mirroring-test#previewResource',
                                     title: "#{title} · レッスン教材", resource_kind: 'materials' } }
              レッスン教材
              = render 'icon', name: 'download'
