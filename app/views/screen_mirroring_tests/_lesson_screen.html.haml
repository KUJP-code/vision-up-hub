:ruby
  phrases = {
    'see-you' => 'See you!', 'hello' => 'Hello!', 'nice-to-meet-you' => 'Nice to meet you!'
  }
  basic_lesson = first_week.fetch('lessons').fetch('basic')

.lm-lesson-dialog{ hidden: true,
                   role: 'dialog',
                   'aria-modal': 'true',
                   'aria-label': 'レッスン画面',
                   data: { 'screen-mirroring-test-target': 'lessonDialog' } }
  .lm-stage{ data: { 'screen-mirroring-test-target': 'lessonScreen' } }
    .lm-splash-viewport
      .lm-splash-frame{ data: { 'screen-mirroring-test-target': 'splash', week: 1 } }
        = image_tag first_week.fetch('splash'), class: 'lm-splash', alt: first_week.fetch('splash_alt'),
                    data: { 'screen-mirroring-test-target': 'splashImage' }
        %div{ data: { 'screen-mirroring-test-target': 'greetingHotspots' } }
          - phrases.each do |position, phrase|
            %button.lm-speech-hotspot{ class: "lm-speech-#{position}",
                                       type: 'button',
                                       'aria-label': "#{phrase} を聞く",
                                       data: { action: 'screen-mirroring-test#speak', phrase: } }
              %span.lm-speech-icon{ 'aria-hidden': 'true' }
                = render 'icon', name: 'sound'
    - phrases.each do |clip, phrase|
      %audio{ preload: 'auto',
              src: asset_path("speech/#{clip}.wav"),
              data: { 'screen-mirroring-test-target': 'phraseAudio', phrase: } }
    - @lesson_weeks.each do |week, content|
      - content.fetch('flashcards').each do |phrase|
        - asset = "week-#{week}/#{phrase.downcase.delete_suffix('!').tr(' ', '-')}"
        %audio{ preload: 'none',
                src: asset_path("#{asset}.mp3"),
                data: { 'screen-mirroring-test-target': 'phraseAudio', phrase:, week:, artwork: asset_path("#{asset}.svg") } }
    %p.lm-sr-only{ role: 'status', data: { 'screen-mirroring-test-target': 'speechStatus' } }
    %header.lm-lesson-menu{ data: { 'screen-mirroring-test-target': 'menu' } }
      .lm-lesson-badge
        .lm-badge-icon
          = render 'icon', name: 'book'
        %div
          %p{ data: { 'screen-mirroring-test-target': 'lessonWeek' } } 第1週 · ベーシックイングリッシュ
          %h2{ data: { 'screen-mirroring-test-target': 'lessonTitle' } }= basic_lesson.fetch('title')
      %nav.lm-lesson-tabs{ 'aria-label': 'レッスンメニュー' }
        %button.lm-pill.lm-primary{ type: 'button',
                                    data: { 'screen-mirroring-test-target': 'basicTab',
                                            action: 'screen-mirroring-test#playVideo',
                                            src: basic_lesson.fetch('video'),
                                            caption_src: asset_path(basic_lesson.fetch('subtitle_asset')),
                                            kind: 'basic',
                                            title: basic_lesson.fetch('title') } } ベーシックイングリッシュ
        %button.lm-pill{ type: 'button',
                         data: { action: 'screen-mirroring-test#openFlashcards' } } フラッシュカード
        %button.lm-pill{ type: 'button',
                         'aria-haspopup': 'dialog',
                         data: { action: 'screen-mirroring-test#openPicker', kind: 'activity' } }
          アクティビティ
        %button.lm-pill{ type: 'button',
                         'aria-haspopup': 'dialog',
                         data: { 'screen-mirroring-test-target': 'storyTab',
                                 action: 'screen-mirroring-test#openPicker', kind: 'story' } }
          ストーリータイム
      %button.lm-close{ type: 'button',
                        'aria-label': 'レッスンを終了',
                        data: { action: 'screen-mirroring-test#closeLesson' } }
        = render 'icon', name: 'close'

    %dialog.lm-picker{ 'aria-label': 'レッスンを選ぶ', data: { 'screen-mirroring-test-target': 'picker' } }
      %button.lm-close.lm-modal-close{ type: 'button',
                                       'aria-label': '閉じる',
                                       data: { action: 'screen-mirroring-test#closePicker' } }
        = render 'icon', name: 'close'
      .lm-picker-scroll{ data: { 'screen-mirroring-test-target': 'pickerScroll' } }
        %section{ data: { 'screen-mirroring-test-target': 'pickerActivity' },
                  'aria-label': 'アクティビティを選ぶ' }
          - activities.each do |week, items|
            %div{ hidden: week != 1, data: { 'screen-mirroring-test-target': 'pickerWeek', week: } }
              = render 'content_cards', items:, kind: 'activity'
        %section{ hidden: true,
                  data: { 'screen-mirroring-test-target': 'pickerStory' },
                  'aria-label': 'ストーリーを選ぶ' }
          = render 'content_cards', items: stories, kind: 'story'

    = render 'flashcards'

    = render 'video_player', basic_lesson:
