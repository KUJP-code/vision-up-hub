:ruby
  story_video = 'https://player.vimeo.com/external/1225145089.m3u8?' \
                's=182f1f053af84f2f1c03c0db77b8fb08e335e690&logging=false'
  basic_video = @lesson_content.fetch('lessons').fetch('basic').fetch('video')
  activities = @lesson_content.fetch('lessons').filter_map do |key, lesson|
    lesson.merge('key' => key) if key.start_with?('activity-')
  end
  stories = ['にげだしたふうせん', 'はらぺこのくま', 'まほうのぼうし', 'ちいさな種', 'おやすみ、おつきさま']
  nav_items = [
    %w[home ホーム home],
    %w[basic ベーシックイングリッシュ book],
    %w[activities アクティビティ activity],
    %w[stories ストーリータイム cards]
  ]

.lesson-mockup{ data: { controller: 'screen-mirroring-test',
                       action: 'pointerover->screen-mirroring-test#prepareVideo focusin->screen-mirroring-test#prepareVideo pointerdown->screen-mirroring-test#prepareVideo',
                       'screen-mirroring-test-content-value': @lesson_content.to_json } }
  %aside.lm-sidebar{ 'aria-label': 'AI先生 ナビゲーション',
                     data: { 'screen-mirroring-test-target': 'sidebar' } }
    %button.lm-nav-button.lm-nav-toggle{ type: 'button',
                                         'aria-label': 'メニューを開く',
                                         'aria-expanded': 'false',
                                         data: { action: 'screen-mirroring-test#toggleSidebar' } }
      = render 'icon', name: 'menu'
    - nav_items.each do |view, label, icon|
      %button.lm-nav-button{ type: 'button',
                             title: label,
                             'aria-label': label,
                             'aria-current': view == 'home' ? 'page' : nil,
                             data: { action: 'screen-mirroring-test#navigate',
                                     view:,
                                     'screen-mirroring-test-target': 'navButton' } }
        = render 'icon', name: icon
        %span.lm-nav-label= label
    - if current_user.is?('AiSensei')
      = link_to destroy_user_session_path, class: 'lm-hub-link', title: 'ログアウト',
                'aria-label': 'ログアウト', data: { turbo_method: :delete, turbo_frame: '_top' } do
        = render 'icon', name: 'logout'
        %span.lm-nav-label ログアウト
    - else
      = link_to root_path, class: 'lm-hub-link', title: '管理画面に戻る' do
        %span ↩
        %span.lm-nav-label 管理画面に戻る
  .lm-workspace
    %header.lm-page-header
      .lm-week-navigation{ data: { 'screen-mirroring-test-target': 'homeHeader' } }
        %button.lm-pill{ type: 'button',
                         data: { action: 'screen-mirroring-test#changeDate', offset: -7 } }
          = render 'icon', name: 'previous'
          先週
        %div
          %h1{ data: { 'screen-mirroring-test-target': 'weekHeading' } } 今週のレッスン
          %label
            %span.lm-sr-only レッスン日
            %input.lm-lesson-date{ type: 'date', value: Date.current.iso8601,
                                   data: { 'screen-mirroring-test-target': 'date',
                                           action: 'change->screen-mirroring-test#updateWeek' } }
        %button.lm-pill{ type: 'button',
                         data: { action: 'screen-mirroring-test#changeDate', offset: 7 } }
          来週
          = render 'icon', name: 'next'
      %h1{ hidden: true, data: { 'screen-mirroring-test-target': 'pageTitle' } }
    %main.lm-pages
      %section{ data: { 'screen-mirroring-test-target': 'page', view: 'home' },
                'aria-label': '今日のレッスン' }
        %div{ data: { 'screen-mirroring-test-target': 'homeLesson' } }
          = render 'lesson_card', week: 1
          = render 'content_cards', items: activities, kind: 'activity'
        %div{ hidden: true, data: { 'screen-mirroring-test-target': 'homeUpcoming' } }
          = render 'upcoming_lesson_card', week: 2, week_target: 'upcomingWeek'
        %p.lm-hint.lm-sample-note 第１週はサンプルレッスンです。次の週のレッスンは準備中です。
      %section{ hidden: true,
                data: { 'screen-mirroring-test-target': 'page', view: 'basic' },
                'aria-label': 'ベーシックイングリッシュのメニュー' }
        = render 'lesson_card', week: 1
        .lm-upcoming-grid
          - (2..10).each do |week|
            = render 'upcoming_lesson_card', week:
      %section{ hidden: true,
                data: { 'screen-mirroring-test-target': 'page', view: 'activities' },
                'aria-label': 'アクティビティのメニュー' }
        .lm-filters{ 'aria-label': 'アクティビティの種類' }
          - ['全て', *activities.map { |activity| activity.fetch('category') }.uniq].each do |category|
            %button.lm-pill{ type: 'button',
                             'aria-pressed': category == '全て' ? 'true' : 'false',
                             data: { action: 'screen-mirroring-test#filterActivities',
                                     category:,
                                     'screen-mirroring-test-target': 'filter' } }= category
        = render 'content_cards', items: activities, kind: 'activity'
      %section{ hidden: true,
                data: { 'screen-mirroring-test-target': 'page', view: 'stories' },
                'aria-label': 'ストーリーのメニュー' }
        = render 'content_cards', items: stories, video: story_video, kind: 'story'

  = render 'resource_dialog'

  = render 'lesson_screen', basic_video:, story_video:, activities:, stories:
