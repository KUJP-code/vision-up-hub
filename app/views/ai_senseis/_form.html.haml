-# locals: (user:, orgs:)

= form_with model: [user.organisation, user], html: { class: 'form', id: 'ai_sensei_form' } do |f|
  = render 'shared/form_errors', resource: user
  = render 'users/fields', f:, orgs:
  .flex.gap-3
    = f.submit class: 'btn btn-main', id: 'submit_ai_sensei'
    - unless user.new_record?
      = link_to 'Delete', organisation_ai_sensei_path(user.organisation, user),
                data: { turbo_method: :delete, turbo_confirm: 'Delete this ai-sensei event account?' },
                class: 'btn btn-danger'
