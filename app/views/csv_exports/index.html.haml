= render 'shared/subtitle', text: 'CSV Exports'

%main.flex.flex-col.gap-6.p-3
  %nav.tab-nav
    = link_to 'General', csv_exports_path, class: "nav-tab #{params[:tab] == 'tests' ? 'inactive' : 'active'}"
    = link_to 'Tests', csv_exports_path(tab: 'tests'), class: "nav-tab #{params[:tab] == 'tests' ? 'active' : 'inactive'}"

  - if params[:tab] == 'tests'
    .flex.flex-col.items-center.gap-4.p-6.rounded.border.border-main.bg-white
      %h2 Test results
      %p Export every recorded test result for #{@organisation.name}. This export is restricted to your organisation.
      = link_to 'Export all organisation test results', csv_export_path(id: 0, model: 'TestResult'), class: 'btn btn-main'
  - else
    .h-full.flex.flex-wrap.justify-around.items-center.gap-6
      .flex.flex-col.gap-3.p-3.rounded.border.border-main
        %h2 Export all records
        - (@allowed_models - ['TestResult']).each do |model|
          = link_to "Export all #{model.titleize.pluralize}", csv_export_path(id: 0, model:), class: 'btn btn-main'
      .flex.flex-col.gap-3.p-3.rounded.border.border-secondary
        %h2 Filter for export
        = link_to 'Lesson', new_csv_export_path(model: 'Lesson'), class: 'btn btn-secondary'
